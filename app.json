{
  "expo": {
    "name": "Recipe Box",
    "slug": "Recipe-Box",
    "owner": "dextertenchavez",
    "scheme": "recipebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/recipe.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/recipe.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dextertenchavez.RecipeBook"
    },
    "android": {
      "package": "com.dextertenchavez.RecipeBook",
      "adaptiveIcon": {
        "foregroundImage": "./assets/recipe.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/recipe.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "googleWebClientId": "157942699599-miao9gillg9t60cbog343vgtav41kcah.apps.googleusercontent.com",
      "eas": {
        "projectId": "acc01607-7779-467c-bef8-16d0249d3504"
      }
    }
  }
}