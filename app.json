{
  "expo": {
    "name": "Recipe Box",
    "slug": "Recipe-Book",
    "owner": "jerichogunayan",
    "scheme": "recipebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pic-logo.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/pic-logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jerichogunayan.recipebook"
    },
    "android": {
      "package": "com.jerichogunayan.recipebook",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pic-logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/pic-logo.jpeg"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a9c2d47f-6420-4a91-9fa0-a5811d40397c"
      }
    }
  }
}
